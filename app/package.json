{
  "name": "weftext-app",
  "version": "0.7.0-rc.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../scripts/generate_ui_messages.mjs --check && tsc --noEmit && vite build",
    "typecheck": "node ../scripts/generate_ui_messages.mjs --check && tsc --noEmit",
    "test": "node ../scripts/generate_ui_messages.mjs --check && tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
