WEFTEXT_UID=10001
WEFTEXT_GID=10001
# Production compose intentionally has no local/floating image default. Set an
# immutable release repository and its externally verified OCI manifest digest.
WEFTEXT_SERVER_IMAGE_REPOSITORY=ghcr.io/example/weftext-server
WEFTEXT_SERVER_IMAGE_DIGEST=
# Use a reviewed Alpine-based official Nginx image; the deployment relies on
# its /bin/busybox, envsubst, stat, and nginx commands. Keep the digest empty
# until the exact multi-platform release manifest has been independently verified.
WEFTEXT_PROXY_IMAGE_REPOSITORY=docker.io/library/nginx
WEFTEXT_PROXY_IMAGE_DIGEST=
# These existing host paths must be owned by the numeric deployment UID/GID.
# The proxy reads only the backend-created 0600 reverse-proxy-secret file through
# the same identity; it never mounts the rest of the control plane.
WEFTEXT_WORKSPACE_PATH=/srv/weftext/workspace
WEFTEXT_CONTROL_PATH=/srv/weftext/control
WEFTEXT_TLS_CERTIFICATE_PATH=/srv/weftext/tls/fullchain.pem
WEFTEXT_TLS_PRIVATE_KEY_PATH=/srv/weftext/tls/private-key.pem
WEFTEXT_PUBLIC_ORIGIN=https://notes.example.test
WEFTEXT_PUBLIC_AUTHORITY=notes.example.test
WEFTEXT_PUBLIC_HOST=notes.example.test
WEFTEXT_HTTPS_PORT=443
