+// Bounded editor experiment: actual final-native text to official source node.
+// Origin is evidence, not a writer capability; the consumer applies its profile.
+fn editor_origin(span: Span, world: &SystemWorld) -> serde_json::Value {
+    use typst::World;
+    let Some(id) = span.id() else { return serde_json::Value::Null; };
+    let Ok(source) = world.source(id) else { return serde_json::Value::Null; };
+    let Some(node) = source.find(span) else { return serde_json::Value::Null; };
+    let range = node.range();
+    let mut ancestors = Vec::new();
+    let mut parent = node.parent();
+    while let Some(p) = parent {
+        ancestors.push(serde_json::json!({"kind":format!("{:?}", p.kind()), "start":p.range().start,"end":p.range().end}));
+        parent = p.parent();
+    }
+    serde_json::json!({
+        "file":format!("{:?}",id.vpath()),
+        "start":range.start,"end":range.end,
+        "raw":source.text().get(range).unwrap_or(""),
+        "kind":format!("{:?}",node.kind()),"ancestors":ancestors,
+        "syntax_kinds":editor_syntax_kinds(source.root())
+    })
+}
+
+fn editor_syntax_kinds(node: &typst::syntax::SyntaxNode) -> Vec<String> {
+    let mut kinds = vec![format!("{:?}", node.kind())];
+    for child in node.children() {
+        kinds.extend(editor_syntax_kinds(child));
+    }
+    kinds.sort();
+    kinds.dedup();
+    kinds
+}
