+// Isolated bounded style adapter. Never evaluates user content again.
+use ecow::eco_format;
+use typst_library::foundations::StyleChain;
+use typst_library::text::{self, TextElem, FontStyle};
+use typst_library::visualize::Paint;
+use crate::css;
+pub fn enabled() -> bool { std::env::var_os("TYPST_HTML_STYLE_PROBE").is_some() }
+pub fn text_css(styles: StyleChain) -> css::Properties {
+    let names = text::families(styles).map(|s| {
+        // CSS string escape every non-ASCII-safe character, including quotes.
+        let v: String = s.as_str().chars().map(|c| if c.is_ascii_alphanumeric() || c == ' ' || c == '-' { c.to_string() } else { format!("\\{:x} ", c as u32) }).collect();
+        format!("\"{v}\"")
+    }).collect::<Vec<_>>().join(", ");
+    let variant = text::variant(styles);
+    let mut css = css::Properties::build(())
+        .with("font-size", styles.resolve(TextElem::size)).finish();
+    css.push("font-family", names);
+    css.push("font-weight", eco_format!("{}", variant.weight.to_number()));
+    css.push("font-style", match variant.style { FontStyle::Normal => "normal", FontStyle::Italic => "italic", FontStyle::Oblique => "oblique" });
+    if let Paint::Solid(color) = styles.get_ref(TextElem::fill) {
+        let color = css::Properties::build(()).with("color", color.clone()).finish();
+        for p in color.iter() { css.push(p.name, p.value.clone()); }
+    }
+    css
+}
