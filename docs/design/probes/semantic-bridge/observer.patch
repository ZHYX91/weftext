@@ -0,0 +1,83 @@
+//! Isolated research observer. No Content/style/engine mutation.
+use std::io::Write;
+use std::sync::{LazyLock, Mutex};
+use std::sync::atomic::{AtomicU64, Ordering};
+use serde_json::{Value as Json, json};
+use typst_library::foundations::{Content, Value};
+static PATH: LazyLock<Option<std::path::PathBuf>> = LazyLock::new(|| std::env::var_os("WEFTEXT_PROBE_LOG").map(Into::into));
+static LOCK: Mutex<()> = Mutex::new(());
+static SEQ: AtomicU64 = AtomicU64::new(0);
+pub fn emit(stage: &str, payload: Json) {
+    let Some(path) = PATH.as_ref() else {return};
+    if std::env::var("WEFTEXT_PROBE_MODE").as_deref() == Ok("world-only") && !stage.starts_with("world_") && stage != "final_frames" {return;}
+    let _lock = LOCK.lock().unwrap();
+    let seq = SEQ.fetch_add(1, Ordering::Relaxed);
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f,"{}",json!({"seq":seq,"stage":stage,"payload":payload}));
+    }
+}
+pub fn content(c: &Content) -> Json { node(c,0) }
+fn node(c: &Content, depth: usize) -> Json {
+    if depth > 32 {return json!({"truncated":true})}
+    if let Some(t)=c.to_packed::<typst_library::introspection::TagElem>() { return json!({"elem":"tag","tag":tag(&t.tag,depth+1)}); }
+    let fields: serde_json::Map<String,Json> = c.fields().iter().map(|(k,v)|(k.to_string(),value(v,depth+1))).collect();
+    json!({"elem":c.elem().name(),"span":format!("{:?}",c.span()),"file":c.span().id().map(|id|format!("{:?}",id)),"location":c.location().map(|l|format!("{:?}",l)),"fields":fields})
+}
+fn value(v: &Value, depth: usize) -> Json {
+    if depth > 32 {return json!({"truncated":true})}
+    match v {
+        Value::Content(c)=>node(c,depth),
+        Value::Array(a)=>Json::Array(a.iter().map(|v|value(v,depth+1)).collect()),
+        Value::Dict(d)=>Json::Object(d.iter().map(|(k,v)|(k.to_string(),value(v,depth+1))).collect()),
+        Value::None=>Json::Null,
+        Value::Bool(b)=>json!(b),
+        Value::Int(n)=>json!(n),
+        Value::Float(n)=>json!(n),
+        Value::Str(s)=>json!(s.as_str()),
+        _=>json!({"repr":format!("{:?}",v)})
+    }
+}
+
+pub fn frame(f: &typst_library::layout::Frame) -> Json {
+    use typst_library::layout::FrameItem;
+    json!({"items":f.items().map(|(pos,item)|{
+        let entry = match item {
+            FrameItem::Group(g)=>json!({"kind":"group","parent":format!("{:?}",g.parent),"frame":frame(&g.frame)}),
+            FrameItem::Text(t)=>json!({"kind":"text","text":t.text.as_str(),"glyph_spans":t.glyphs.iter().map(|g|json!({"span":format!("{:?}",g.span.0),"offset":g.span.1,"range":[g.range.start,g.range.end]})).collect::<Vec<_>>() }),
+            FrameItem::Tag(t)=>json!({"kind":"tag","tag":tag(t,0)}),
+            _=>json!({"kind":"other","repr":format!("{:?}",item)})
+        };
+        json!({"position":format!("{:?}",pos),"item":entry})
+    }).collect::<Vec<_>>()})
+}
+
+pub fn observe(engine: &mut typst_library::engine::Engine, stage: &str, payload: Json) {
+    if PATH.is_some() && std::env::var("WEFTEXT_PROBE_MODE").as_deref() != Ok("world-only") {
+        engine.sink.probe(json!({"stage":stage,"payload":payload}).to_string().into());
+    }
+}
+pub fn source(source: &typst_syntax::Source) -> Json {
+    fn walk(n: &typst_syntax::SyntaxNode, source: &typst_syntax::Source, out: &mut Vec<Json>) {
+        let range = source.find(n.span()).map(|node|node.range());
+        out.push(json!({"span":format!("{:?}",n.span()),"kind":format!("{:?}",n.kind()),"range":range.clone(),"text":range.map(|r|source.text()[r].to_owned())}));
+        for child in n.children() {walk(child,source,out);}
+    }
+    let mut nodes=vec![];walk(source.root(),source,&mut nodes);
+    json!({"file":format!("{:?}",source.id()),"nodes":nodes})
+}
+
+
+fn tag(t: &typst_library::introspection::Tag, depth: usize) -> Json {
+    use typst_library::introspection::Tag;
+    match t {
+        Tag::Start(c,flags)=>json!({"kind":"start","content":node(c,depth),"flags":format!("{:?}",flags),"location":format!("{:?}",t.location())}),
+        Tag::End(loc,hash,flags)=>json!({"kind":"end","location":format!("{:?}",loc),"key_hash":format!("{:032x}",hash),"flags":format!("{:?}",flags)})
+    }
+}
+pub fn effective(c: &Content, st: typst_library::foundations::StyleChain) -> Json {
+    use typst_library::text::TextElem;
+    let fields: serde_json::Map<String,Json> = ["level","outlined","numbering","block","columns","dir","weight","style","lang"].into_iter().filter_map(|name|{
+        c.elem().field_id(name).and_then(|id|c.get(id,Some(st)).ok()).map(|v|(name.into(),value(&v,0)))
+    }).collect();
+    json!({"fields":fields,"text_direction":format!("{:?}",st.resolve(TextElem::dir)),"text_weight":format!("{:?}",st.get(TextElem::weight)),"text_style":format!("{:?}",st.get(TextElem::style))})
+}
