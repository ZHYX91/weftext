{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.local/schemas/docling-lite-assets-lock.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "doclingReleaseTag", "doclingReleaseCommit", "documentSchemaName", "documentSchemaVersion", "profile", "target", "network", "noTableFormer", "ocrLanguage", "totalPackageBytes", "completeForExecution", "missingForExecution", "artifacts", "distributionArchives"],
  "properties": {
    "lockVersion": { "const": "weftext.docling-lite-assets.v1" },
    "doclingReleaseTag": { "const": "v0.52.2" },
    "doclingReleaseCommit": { "pattern": "^[0-9a-f]{40}$" },
    "documentSchemaName": { "const": "DoclingDocument" },
    "documentSchemaVersion": { "const": "1.10.0" },
    "profile": { "const": "pdfium-layout-int8-ppocrv3-en" },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
    "network": { "const": "denied" },
    "noTableFormer": { "const": true },
    "ocrLanguage": { "const": "en" },
    "totalPackageBytes": { "type": "integer", "minimum": 1 },
    "completeForExecution": { "type": "boolean" },
    "missingForExecution": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
    "distributionArchives": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/distribution" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "role", "target", "installPath", "sourceUrl", "byteLength", "sha256", "license", "noticeId"],
      "properties": {
        "component": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "enum": ["worker_binary", "native_library", "embedded_component", "model", "dictionary"] },
        "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "installPath": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "noticeId": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "target", "sourceUrl", "byteLength", "sha256", "license", "noticeId"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "noticeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
