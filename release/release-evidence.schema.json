{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.example/schemas/release-evidence-v1.schema.json",
  "title": "Weftext verified release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "sourceCommit",
    "sourceDateEpoch",
    "releaseInput",
    "sourceTreeSha256",
    "toolchains",
    "lockfiles",
    "packageInputs",
    "dependencyLicenses",
    "sourceManifest",
    "generatedFiles",
    "artifacts",
    "sboms",
    "noticeFiles",
    "testEvidence",
    "knownLimitations",
    "migrationPath",
    "backupCompatibility",
    "rollbackProcedure",
    "releaseSetSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "weftext.release-evidence.v1"
    },
    "releaseVersion": {
      "$ref": "#/$defs/version"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "releaseInput": {
      "$ref": "#/$defs/fileDigest"
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust",
        "node",
        "cosign"
      ],
      "properties": {
        "rust": {
          "$ref": "#/$defs/version"
        },
        "node": {
          "$ref": "#/$defs/version"
        },
        "cosign": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "lockfiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/fileDigest"
      }
    },
    "packageInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileDigest"
      }
    },
    "dependencyLicenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo",
        "doclingWorkerCargo",
        "npm"
      ],
      "properties": {
        "cargo": {
          "const": "cargo-licenses.json"
        },
        "doclingWorkerCargo": {
          "const": "docling-worker-cargo-licenses.json"
        },
        "npm": {
          "const": "npm-licenses.json"
        }
      }
    },
    "sourceManifest": {
      "const": "source-files.json"
    },
    "generatedFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifestSha256",
        "cargoLicensesSha256",
        "doclingWorkerCargoLicensesSha256",
        "npmLicensesSha256"
      ],
      "properties": {
        "sourceManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cargoLicensesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "doclingWorkerCargoLicensesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "npmLicensesSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "sboms": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/sbom"
      }
    },
    "noticeFiles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/scopedFile"
      }
    },
    "testEvidence": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/testFile"
      }
    },
    "knownLimitations": {
      "$ref": "#/$defs/fileDigest"
    },
    "migrationPath": {
      "$ref": "#/$defs/fileDigest"
    },
    "backupCompatibility": {
      "$ref": "#/$defs/fileDigest"
    },
    "rollbackProcedure": {
      "$ref": "#/$defs/fileDigest"
    },
    "releaseSetSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "enum": [
        "cargo",
        "desktop-npm",
        "docling-worker-cargo",
        "server-container",
        "server-webui-npm",
        "webui-npm"
      ]
    },
    "component": {
      "enum": [
        "cli",
        "desktop",
        "server",
        "server-container",
        "webui"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundlePath",
        "bundleSha256",
        "certificateIdentity",
        "certificateOidcIssuer",
        "verifiedBy",
        "verifiedSubject"
      ],
      "properties": {
        "bundlePath": {
          "type": "string",
          "minLength": 1
        },
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "certificateIdentity": {
          "type": "string",
          "format": "uri"
        },
        "certificateOidcIssuer": {
          "const": "https://token.actions.githubusercontent.com"
        },
        "verifiedBy": {
          "type": "string",
          "pattern": "^cosign [0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "verifiedSubject": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "component",
        "platform",
        "version",
        "signature",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "ociReference": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "component": {
                "const": "server-container"
              }
            }
          },
          "then": {
            "required": [
              "ociReference"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "size"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "path",
              "size"
            ],
            "not": {
              "required": [
                "ociReference"
              ]
            }
          }
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "path",
        "sha256",
        "generator"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        }
      }
    },
    "scopedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "path",
        "sha256"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "testFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "path",
        "sha256"
      ],
      "properties": {
        "layer": {
          "enum": [
            "backup-disaster-recovery",
            "cli",
            "collaboration-multi-client",
            "core-source",
            "desktop-packaged",
            "filesystem-integration",
            "manual-accessibility-daily-use",
            "server-container-packaged",
            "webui-supported-browser"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
