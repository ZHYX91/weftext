{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weftext:recognition-worker-request:1",
  "title": "Offline recognition worker request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inputPath", "inputSha256", "mediaType", "languages"],
  "allOf": [
    { "if": { "required": ["operation"], "properties": { "operation": { "const": "inspect" } } }, "then": { "not": { "required": ["pages"] } }, "else": { "required": ["pages"] } }
  ],
  "properties": {
    "version": { "const": 1 },
    "operation": { "enum": ["recognize", "preview", "inspect"], "default": "recognize", "description": "inspect returns all bounded page dimensions without raster/OCR and omits pages; preview returns selected whole-page PNGs without OCR." },
    "inputPath": { "type": "string", "minLength": 1, "description": "Operator-selected absolute path to already-authorized immutable input; never accept a client path." },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mediaType": { "enum": ["application/pdf", "image/png", "image/jpeg"] },
    "languages": { "enum": [["eng"], ["chi_sim"], ["chi_tra"], ["chi_sim", "eng"], ["chi_tra", "eng"]] },
    "dpi": { "type": "integer", "minimum": 72, "maximum": 300, "default": 300 },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["page"],
        "properties": {
          "page": { "type": "integer", "minimum": 1, "maximum": 100 },
          "regions": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "rect"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "^__weftext_auto_" } },
                "rect": { "$ref": "#/$defs/rect" },
                "mode": { "enum": ["auto", "text", "ocr"], "default": "auto" },
                "rotation": { "enum": [0, 90, 180, 270], "default": 0 },
                "segmentation": { "enum": ["auto", "sparse", "block", "line"], "default": "auto" },
                "ocrScale": { "enum": [0.5, 0.75, 1], "default": 1, "description": "Explicit LANCZOS downsampling of derived OCR raster only; coordinates map back to the original selected page." }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "exclusiveMaximum": 100000 },
      "description": "[left, top, right, bottom] in visible-page-top-left coordinates; PDF points or EXIF-oriented image pixels. Positive dimensions, containment, unique IDs and nonoverlap are validated by worker."
    }
  }
}
