{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.org/schemas/property-value-v1.schema.json",
  "title": "Weftext derived property scalar value v1",
  "description": "Format-neutral transport for a scalar classified from an exact top-level user YAML property. This is derived data, never a second storage authority.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "null" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": { "kind": { "const": "text" }, "value": { "type": "string" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "integer" },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "decimal" },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]+$",
          "maxLength": 58
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "date" },
        "value": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "instant" },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    }
  ]
}
