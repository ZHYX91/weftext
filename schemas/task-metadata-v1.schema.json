{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.org/schemas/task-metadata-v1.schema.json",
  "title": "Historical Weftext inline Task Metadata v1 decoded field values",
  "description": "Pre-release implementation and conversion evidence for the superseded trailing task:[...] macro. It is not canonical target output; durable target tasks use task-node-v1.schema.json and node UUID identity.",
  "$comment": "Retained until workspace-wide task-macro-to-node conversion and rollback evidence is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "$ref": "#/$defs/taskId" },
    "phase": { "enum": ["todo", "in-progress", "on-hold"] },
    "resolution": { "enum": ["completed", "cancelled"] },
    "priority": {
      "enum": ["highest", "high", "medium", "normal", "low", "lowest"],
      "default": "normal"
    },
    "created": { "$ref": "#/$defs/dateTime" },
    "start": { "$ref": "#/$defs/dateTime" },
    "scheduled": { "$ref": "#/$defs/dateTime" },
    "due": { "$ref": "#/$defs/dateTime" },
    "closed": { "$ref": "#/$defs/dateTime" },
    "rrule": { "type": "string", "minLength": 1 },
    "repeat-from": { "enum": ["due", "scheduled", "completion"] },
    "depends-on": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}( [0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})*$"
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
      ]
    }
  }
}
