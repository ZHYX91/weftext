{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.org/schemas/task-node-v1.schema.json",
  "title": "Weftext Task Node Profile v1 decoded header values",
  "description": "Machine-readable decoded-field boundary for literal weftext-task and weftext-task-* AsciiDoc document-header attributes. Node identity remains weftext.id and is not repeated here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "state"],
  "properties": {
    "profile": { "const": "v1" },
    "state": { "enum": ["todo", "in-progress", "on-hold", "completed", "cancelled"] },
    "priority": {
      "enum": ["highest", "high", "medium", "normal", "low", "lowest"],
      "default": "normal"
    },
    "created": { "$ref": "#/$defs/dateTime" },
    "start": { "$ref": "#/$defs/dateTime" },
    "scheduled": { "$ref": "#/$defs/dateTime" },
    "due": { "$ref": "#/$defs/dateTime" },
    "closed": { "$ref": "#/$defs/dateTime" },
    "depends-on": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}( [0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "enum": ["todo", "in-progress", "on-hold"] } },
        "required": ["state"]
      },
      "then": { "not": { "required": ["closed"] } }
    }
  ],
  "$defs": {
    "dateTime": {
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
      ]
    }
  }
}
