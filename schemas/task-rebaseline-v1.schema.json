{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftext.org/schemas/task-rebaseline-v1.schema.json",
  "title": "Weftext legacy task macro rebaseline preview v1",
  "description": "Closed, path-safe, read-only complete-local workspace inventory and preview. The local capture does not prove identity or grant Owner ACL; this DTO contains no mutation authority, commit token, hosted completeness, or external snapshot claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "previewOnly",
    "committable",
    "conversionReady",
    "baseWorkspaceRevision",
    "preState",
    "annotationReplicaCompleteness",
    "occurrences",
    "identityMap",
    "sourcePreviews",
    "queries",
    "blockers",
    "planDigest"
  ],
  "properties": {
    "schema": { "const": "weftext.task-rebaseline/v1" },
    "scope": { "const": "owner_workspace" },
    "previewOnly": { "const": true },
    "committable": { "const": false },
    "conversionReady": { "type": "boolean" },
    "baseWorkspaceRevision": { "$ref": "#/$defs/sha256" },
    "preState": { "$ref": "#/$defs/preState" },
    "annotationReplicaCompleteness": { "const": "complete_local_workspace" },
    "occurrences": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "identityMap": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/identityMapping" }
    },
    "sourcePreviews": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/sourcePreview" }
    },
    "queries": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/query" }
    },
    "blockers": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/blocker" }
    },
    "planDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "anyOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "nullableRange": {
      "anyOf": [
        { "$ref": "#/$defs/range" },
        { "type": "null" }
      ]
    },
    "preState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRevision",
        "portableInventoryBinding",
        "physicalInventoryBinding",
        "externalSnapshotBinding"
      ],
      "properties": {
        "workspaceRevision": { "$ref": "#/$defs/sha256" },
        "portableInventoryBinding": { "const": "full_owner_workspace" },
        "physicalInventoryBinding": { "const": "workspace_revision_only" },
        "externalSnapshotBinding": { "const": "not_provided" }
      }
    },
    "blockerCode": {
      "enum": [
        "invalid_legacy_task",
        "malformed_macro_residue",
        "parser_alignment_unproven",
        "incomplete_structured_branch",
        "duplicate_legacy_task_id",
        "recurrence_unsupported",
        "unresolved_dependency",
        "ambiguous_dependency",
        "self_dependency",
        "dependency_cycle",
        "relative_locator",
        "document_context_dependency",
        "nested_structured_branch_overlap",
        "destination_name_unavailable",
        "destination_content_boundary",
        "destination_collision",
        "annotation_replica_incomplete",
        "annotation_authority_invalid",
        "annotation_migration_required",
        "trash_restore_required",
        "query_population_equivalence_unproven",
        "invalid_task_query"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "sourceNodeId",
        "oldTaskId",
        "dependencyTaskId",
        "range",
        "message"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/blockerCode" },
        "sourceNodeId": { "$ref": "#/$defs/nullableUuid" },
        "oldTaskId": { "$ref": "#/$defs/nullableUuid" },
        "dependencyTaskId": { "$ref": "#/$defs/nullableUuid" },
        "range": { "$ref": "#/$defs/nullableRange" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceNodeId",
        "documentRevision",
        "documentLocator",
        "macroRange",
        "itemRange",
        "markerRange",
        "descriptionRange",
        "rawMacro",
        "rawItem",
        "oldTaskId",
        "generatedNodeId",
        "disposition",
        "blockerCodes"
      ],
      "properties": {
        "sourceKind": {
          "enum": ["active_managed_document", "trash_payload_document"]
        },
        "sourceNodeId": { "$ref": "#/$defs/uuid" },
        "documentRevision": { "$ref": "#/$defs/sha256" },
        "documentLocator": { "$ref": "#/$defs/locator" },
        "macroRange": { "$ref": "#/$defs/range" },
        "itemRange": { "$ref": "#/$defs/nullableRange" },
        "markerRange": { "$ref": "#/$defs/nullableRange" },
        "descriptionRange": { "$ref": "#/$defs/nullableRange" },
        "rawMacro": { "type": "string", "maxLength": 16777216 },
        "rawItem": { "type": "string", "maxLength": 16777216 },
        "oldTaskId": { "$ref": "#/$defs/nullableUuid" },
        "generatedNodeId": { "$ref": "#/$defs/nullableUuid" },
        "disposition": {
          "enum": [
            "proposed_task_node",
            "blocked",
            "protected_literal",
            "trash_restore_required"
          ]
        },
        "blockerCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 22,
          "items": { "$ref": "#/$defs/blockerCode" }
        }
      }
    },
    "identityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId",
        "oldTaskId",
        "generatedNodeId",
        "destinationParentNodeId",
        "destinationNodeLocator",
        "destinationPortableName",
        "documentTitle",
        "linkLabel"
      ],
      "properties": {
        "sourceNodeId": { "$ref": "#/$defs/uuid" },
        "oldTaskId": { "$ref": "#/$defs/uuid" },
        "generatedNodeId": { "$ref": "#/$defs/uuid" },
        "destinationParentNodeId": { "$ref": "#/$defs/uuid" },
        "destinationNodeLocator": { "$ref": "#/$defs/locator" },
        "destinationPortableName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "documentTitle": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "linkLabel": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "taskFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "priority",
        "created",
        "start",
        "scheduled",
        "due",
        "closed",
        "dependsOn"
      ],
      "properties": {
        "state": { "enum": ["todo", "in-progress", "on-hold", "completed", "cancelled"] },
        "priority": {
          "type": ["string", "null"],
          "enum": ["lowest", "low", "normal", "medium", "high", "highest", null]
        },
        "created": { "$ref": "#/$defs/nullableDateTime" },
        "start": { "$ref": "#/$defs/nullableDateTime" },
        "scheduled": { "$ref": "#/$defs/nullableDateTime" },
        "due": { "$ref": "#/$defs/nullableDateTime" },
        "closed": { "$ref": "#/$defs/nullableDateTime" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oldTaskId",
        "generatedNodeId",
        "fields",
        "sourceReplacementRange",
        "expectedSource",
        "replacementSource",
        "proposedTaskSource"
      ],
      "properties": {
        "oldTaskId": { "$ref": "#/$defs/uuid" },
        "generatedNodeId": { "$ref": "#/$defs/uuid" },
        "fields": { "$ref": "#/$defs/taskFields" },
        "sourceReplacementRange": { "$ref": "#/$defs/range" },
        "expectedSource": { "type": "string", "maxLength": 16777216 },
        "replacementSource": { "type": "string", "maxLength": 16777216 },
        "proposedTaskSource": { "type": "string", "maxLength": 16777216 }
      }
    },
    "annotationInventory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "sha256", "annotationCount"],
          "properties": {
            "state": { "const": "present" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "annotationCount": { "type": "integer", "minimum": 0, "maximum": 100000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "confirmed_absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "unproven" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "invalid" } }
        }
      ]
    },
    "sourcePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId",
        "documentRevision",
        "documentLocator",
        "originalSource",
        "proposedSource",
        "annotations",
        "proposals"
      ],
      "properties": {
        "sourceNodeId": { "$ref": "#/$defs/uuid" },
        "documentRevision": { "$ref": "#/$defs/sha256" },
        "documentLocator": { "$ref": "#/$defs/locator" },
        "originalSource": { "type": "string", "maxLength": 16777216 },
        "proposedSource": { "type": "string", "maxLength": 16777216 },
        "annotations": { "$ref": "#/$defs/annotationInventory" },
        "proposals": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/proposal" }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId",
        "documentRevision",
        "documentLocator",
        "range",
        "bodyRange",
        "rawSource",
        "disposition"
      ],
      "properties": {
        "sourceNodeId": { "$ref": "#/$defs/uuid" },
        "documentRevision": { "$ref": "#/$defs/sha256" },
        "documentLocator": { "$ref": "#/$defs/locator" },
        "range": { "$ref": "#/$defs/range" },
        "bodyRange": { "$ref": "#/$defs/range" },
        "rawSource": { "type": "string", "maxLength": 16777216 },
        "disposition": {
          "enum": ["canonical_unchanged", "conversion_blocked", "invalid_blocked"]
        }
      }
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^[^\\\\/]+(?:/[^\\\\/]+)*$"
    },
    "dateTime": {
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
      ]
    },
    "nullableDateTime": {
      "anyOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    }
  }
}
